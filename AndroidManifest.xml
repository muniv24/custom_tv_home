<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ansub.tvhome" android:versionCode="9" android:versionName="1.3.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <!-- Only for the network tile: Wi-Fi, Ethernet or offline, and the Wi-Fi signal. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 11+ only shows apps a home screen asks to see: TV apps and normal apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Settings screens the network tile and the Bluetooth, Sound and Picture shortcuts open. -->
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="com.google.android.intent.action.CONNECT_INPUT" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <package android:name="com.tcl.settings" />
        <!-- Xiaomi Settings, which DolbyKeeper nudges to keep Dolby passthrough on. -->
        <package android:name="com.android.tv.settings" />
        <!-- Google TV's HDMI input player, so HDMI tiles can see when the TV sends HDMI to it. -->
        <package android:name="com.google.android.tv.inputplayer" />
    </queries>
    <!-- Lets "Uninstall" in the app menu open Android's uninstall prompt. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The volume percentage shown over other apps (VolumeOverlay). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The Detox switch talks to the TV's own network debugging on 127.0.0.1 (AdbShell). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Starts the volume box at boot (Boot), also when Detox is off and this isn't the home screen. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="MKSD" android:allowBackup="false"
        android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- With Detox off the TV's own home screen is back: this puts MKSD in its apps, to switch back. -->
        <activity-alias android:name=".Launcher" android:targetActivity=".MainActivity"
            android:label="MKSD" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver android:name=".Boot" android:exported="true">
            <!-- Boot broadcasts go to apps one at a time; high priority starts the volume box ~40 s sooner. -->
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".VolumeOverlay" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the soundbar volume when the TV hides its own volume bar" />
        </service>
    </application>
</manifest>
